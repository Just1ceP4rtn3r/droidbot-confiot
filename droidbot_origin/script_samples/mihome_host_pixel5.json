{
    "views": {
      "smart_image": {
        "in_coordinates": [
            [367,2052],[712,2178]
          ],
          "out_coordinates": [
            [367,2052],[712,2178],[367,2052],[712,2178]
          ]
      },
      "automation_card": {
        "resource_id": ".*card_layout",
        "class": ".*ViewGroup"
      },
      "add_image": {
        "content_desc": "Add device",
        "class": ".*ImageView"
      },
      "createScene_text": {
          "text": "Create a smart scene",
          "class": ".*TextView"
      }
    },
    "states": {
        "goto_scenes": {
            "activity": ".*SmartHomeMainActivity",
            "views": [
                "smart_image"
            ]
        },
        "goto_card": {
            "activity": ".*SmartHomeMainActivity",
            "views": [
                "automation_card"
            ]
        },
        "goto_add": {
          "activity": ".*SmartHomeMainActivity",
          "views": [
              "add_image"
          ]
        },
        "goto_createScene": {
            "activity": ".*SmartHomeMainActivity",
            "views": [
                "createScene_text"
            ]
        }
    },
    "operations": {
      "click_scenes": [
          {
              "event_type": "touch",
              "target_view": "smart_image"
          }
      ],
      "click_automation": [
          {
              "event_type": "touch",
              "target_view": "automation_card"
          }
      ],
      "click_add": [
          {
              "event_type": "touch",
              "target_view": "add_image"
          }
      ],
      "click_add_a_scene": [
          {
              "event_type": "touch",
              "target_view": "createScene_text"
          }
      ]
    },
    "main": {
        "goto_scenes": [
            {
              "op_id": "click_scenes",
              "prob": 0.3
            },
            {
              "op_id": "click_add",
              "prob": 0.3
            }
        ],
        "goto_add": [
            {
                "op_id": "click_add",
                "prob": 0.5
            }
        ],
        "goto_card": [
          {
              "op_id": "click_automation",
              "prob": 0.5
          }
        ],
        "goto_createScene": [
          {
            "op_id": "click_add_a_scene",
            "prob": 0.5
          }  
        ]
    }
  }
  